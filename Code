import pandas as pd
import numpy as np
from sklearn.model_selection import train_test_split
from sklearn.linear_model import LinearRegression
from sklearn.linear_model import Ridge, Lasso
from sklearn.model_selection import cross_val_score
from sklearn.metrics import mean_squared_error, r2_score
from sklearn.preprocessing import MinMaxScaler
from sklearn.feature_selection import SelectKBest, f_regression
from sklearn.linear_model import LassoCV, RidgeCV

mpg = pd.read_csv("/Users/arhaann/Documents/code/Python/auto-mpg.csv")
mpg = mpg.drop(columns=['car name'])
mpg = mpg.apply(lambda col: col.str.strip() if col.dtype == "object" else col)
mpg['horsepower'] = mpg['horsepower'].replace(['?', 'NA', 'nan', 'NULL', ''], pd.NA)
mpg['horsepower'] = pd.to_numeric(mpg['horsepower'], errors='coerce')

mpg['horsepower'] = mpg['horsepower'].fillna(mpg['horsepower'].median())

x = mpg[['weight', 'horsepower', 'cylinders', 'model year', 'acceleration']]
y = mpg['mpg']
lr = LinearRegression()
x_train, x_test, y_train, y_test = train_test_split(x, y, test_size=0.2, random_state=1000)
lr.fit(x_train, y_train)
y_pred = lr.predict(x_test)
mse = mean_squared_error(y_test, y_pred)
r2 = r2_score(y_test, y_pred)

ridge = Ridge(alpha = 0.111)
ridge.fit(x_train, y_train)
ridge_cv = RidgeCV(alphas=np.linspace(0.01, 10, 100))
ridge_cv.fit(x_train, y_train)
ridge_pred = ridge.predict(x_test)

def predict(weight, horsepower, cylinders, model_year, acceleration):
    x = [[weight, horsepower, cylinders, model_year, acceleration]]
    prediction = ridge.predict(x)
    return prediction - 2#Bias

#Example
print(predict(1963, 68, 4, 81, 18.1))
